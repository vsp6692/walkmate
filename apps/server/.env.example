# Compatible local model example; install/download and run your model separately.
# Example base URL after installing a runtime: http://127.0.0.1:11434/v1
# Set the exact model name reported by your runtime. Blank means unconfigured.
LLM_BASE_URL=
LLM_MODEL=
# Optional for hosted endpoints. This file belongs ONLY on the server.
LLM_API_KEY=
HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://localhost:8082
# Optional separate Whisper-compatible transcription provider (without /audio/transcriptions).
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
