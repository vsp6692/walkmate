{
  "name": "walkmate",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "android": "npm --prefix apps/mobile run android",
    "web": "npm --prefix apps/mobile run web",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --export",
    "package:source": "python3 scripts/package-source.py",
    "server": "node apps/server/server.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
